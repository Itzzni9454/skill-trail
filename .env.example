# Skill Trail — optional integrations.
#
# Copy this file to `.env` and fill in what you use. `.env` is gitignored —
# it never leaves your machine. EVERYTHING here is optional: the app is fully
# functional with no integrations at all.
#
# Note: Habitica, Obsidian, Notion and Microsoft To Do can also be configured
# graphically — see the connectors panel in the app. This file covers the
# integrations that are configured by environment instead.

# ── LeetCode (daily challenge board & stats) ────────────────────────────────
# Only the username is needed for public stats (solved counts, streak,
# contest rating) — no login, no cookies, no expiry.
#
# Cookies are OPTIONAL and only extend what's readable (they expire, and
# LeetCode increasingly blocks anonymous reads, so they're recommended):
#   1. Log in to leetcode.com
#   2. DevTools > Application > Cookies > https://leetcode.com
#   3. Copy the value of LEETCODE_SESSION and csrftoken below.

LEETCODE_USERNAME=
LEETCODE_SESSION=
LEETCODE_CSRF=

# ── Habitica (gamified task sync) ───────────────────────────────────────────
# Find these under Habitica → Settings → API.

HABITICA_USER_ID=
HABITICA_API_KEY=

# ── Google Calendar (auto-schedule reviews/dailies into free slots) ─────────
# A Google Cloud service-account JSON key with a shared calendar, and the
# calendar to write to (its email under Settings → Share with).

GOOGLE_SERVICE_ACCOUNT_PATH=server/data/google-service-account.json
GOOGLE_CALENDAR_ID=

# ── Server overrides ────────────────────────────────────────────────────────
# PORT=4177
# LEETCODE_CACHE_MINUTES=30
